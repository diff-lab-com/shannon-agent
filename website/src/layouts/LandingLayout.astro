---
interface Props {
  lang: 'en' | 'zh';
}

const { lang } = Astro.props;
const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, '/');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Shannon — Open-Source AI Workspace. Total Control. Keys Never Leave.</title>
    <meta name="description" content="The open-source AI agent workspace: terminal to desktop, one Rust engine, any LLM provider. Every action replayable, every cost visible, your keys never leave your machine. Apache-2.0." />
    <meta property="og:title" content="Shannon — Open-Source AI Workspace" />
    <meta property="og:description" content="Open source. Total control. Keys never leave your machine. Any LLM provider, terminal to desktop, one Rust engine." />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={base + 'favicon.svg'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
