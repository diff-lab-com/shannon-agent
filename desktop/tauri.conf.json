{
    "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
    "productName": "shannon-desktop",
    "version": "0.11.0",
    "identifier": "com.shannon-agent.desktop",
    "build": {
        "devUrl": "http://localhost:1420",
        "frontendDist": "./ui/dist",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build"
    },
    "bundle": {
        "externalBin": [
            "binaries/shannon"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.png"
        ],
        "linux": {
            "deb": {
                "depends": [
                    "libayatana-appindicator3-1",
                    "libwebkit2gtk-4.1-0",
                    "libgtk-3-0",
                    "libpipewire-0.3-0",
                    "libspa-0.2-0",
                    "libgbm1",
                    "libegl1",
                    "libwayland-client0"
                ]
            },
            "rpm": {
                "depends": [
                    "gtk3",
                    "webkit2gtk4.1",
                    "pipewire-libs",
                    "mesa-libgbm",
                    "mesa-libEGL",
                    "libwayland-client"
                ]
            }
        },
        "windows": {
            "nsis": {
                "installerHooks": "./nsis/hooks.nsh"
            }
        }
    },
    "app": {
        "withGlobalTauri": false,
        "windows": [
            {
                "title": "Shannon Agent",
                "width": 1200,
                "height": 800,
                "minWidth": 800,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false,
                "decorations": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; img-src 'self' data: asset: http://asset.localhost; frame-src 'self' https: http://localhost:* artifact: http://artifact.localhost",
            "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: asset: http://asset.localhost; frame-src 'self' https: http://localhost:* artifact: http://artifact.localhost",
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$HOME/**",
                    "$TEMP/**"
                ]
            }
        }
    },
    "plugins": {
        "globalShortcut": {
            "shortcuts": [
                {
                    "id": "show-hide",
                    "description": "Show/hide Shannon window",
                    "accelerator": "Ctrl+Shift+S"
                },
                {
                    "id": "new-session",
                    "description": "Create new session",
                    "accelerator": "Ctrl+Shift+N"
                },
                {
                    "id": "focus-input",
                    "description": "Focus message input",
                    "accelerator": "Ctrl+Shift+K"
                }
            ]
        }
    }
}