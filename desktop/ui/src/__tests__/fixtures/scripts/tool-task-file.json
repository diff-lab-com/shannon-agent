{
  "name": "tool-task-file",
  "description": "工具任务 journey — 文本流 → Bash 工具 + 进度 → ok 结果 → 文本 → completed",
  "seed": {
    "config": {
      "hasKey": true
    },
    "sessions": [
      {
        "id": "script-sess-tool",
        "title": "Write todo.md",
        "messages": []
      },
      {
        "id": "script-sess-files",
        "title": "Generated files",
        "messages": [
          {
            "role": "user",
            "content": "生成报告 PDF、数据 CSV 和一份笔记"
          },
          {
            "role": "assistant",
            "content": "三个文件都生成好了：report.pdf、data.csv、notes.md。",
            "toolCalls": [
              {
                "toolUseId": "tool-file-pdf",
                "toolName": "write_file",
                "toolInput": {
                  "file_path": "/Users/demo/workspace/shannon-demo/report.pdf",
                  "content": "%PDF-1.4 minimal stub"
                },
                "result": "wrote 1 block",
                "isError": false
              },
              {
                "toolUseId": "tool-file-csv",
                "toolName": "write_file",
                "toolInput": {
                  "file_path": "/Users/demo/workspace/shannon-demo/data.csv",
                  "content": "name,qty\nmilk,2\ntea,1"
                },
                "result": "wrote 3 lines",
                "isError": false
              },
              {
                "toolUseId": "tool-file-md",
                "toolName": "write_file",
                "toolInput": {
                  "file_path": "/Users/demo/workspace/shannon-demo/notes.md",
                  "content": "# Notes\nhello"
                },
                "result": "wrote 2 lines",
                "isError": false
              }
            ]
          }
        ]
      }
    ]
  },
  "turns": [
    {
      "user": "用 Bash 写一个 todo.md，然后告诉我结果",
      "script": [
        {
          "event": "query:text",
          "chunks": [
            "好的，我先创建 ",
            "todo.md："
          ],
          "chunkDelayMs": 200
        },
        {
          "event": "query:tool-start",
          "payload": {
            "tool_use_id": "tool-todo-1",
            "tool_name": "Bash",
            "tool_input": {
              "command": "printf 'buy milk\\nwrite tests\\n' > todo.md"
            }
          }
        },
        {
          "event": "query:tool-progress",
          "payload": {
            "tool_use_id": "tool-todo-1",
            "progress": 0.4,
            "message": "writing todo.md"
          }
        },
        {
          "waitFor": "ui"
        },
        {
          "event": "query:tool-progress",
          "payload": {
            "tool_use_id": "tool-todo-1",
            "progress": 0.8,
            "message": "flushing buffer"
          }
        },
        {
          "event": "query:tool-result",
          "payload": {
            "tool_use_id": "tool-todo-1",
            "result": "wrote 2 lines to todo.md",
            "is_error": false
          }
        },
        {
          "event": "query:text",
          "chunks": [
            "完成！todo.md 已写入 ",
            "2 行待办 ✅"
          ],
          "chunkDelayMs": 200
        },
        {
          "event": "query:completed"
        }
      ]
    }
  ]
}
