{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shannon.dev/schemas/shannon-mobile-protocol-v1.json",
  "title": "shannon/* mobile↔gateway JSON-RPC protocol (v1, 2026-09-17)",
  "description": "Canonical contract for the shannon/* JSON-RPC 2.0 face the gateway (shannon-mono gateway/src/mobile) exposes to shannon-mobile. Sources of truth: gateway/src/mobile/protocol.ts (types, SHANNON_METHODS, ShannonError), pairing.ts, engineBridge.ts, crypto.ts (signed-message formats). Drift on either side is caught by protocolSchema.test.ts (gateway) and protocol_schema_contract_test.dart (mobile). Wire field names are snake_case; relay-transport envelopes (E2E frames, control frames) are specified in shannon-relay docs/wire-protocol.md.",
  "definitions": {
    "JsonRpcRequest": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "method"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "number"
          ]
        },
        "method": {
          "enum": {
            "$ref": "#/definitions/shannonMethods"
          }
        },
        "params": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "shannonMethods": {
      "description": "Every method the gateway recognizes. Mobile keeps a hand-written mirror (Methods) whose real-surface constants must be a subset — pinned by contract test.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "enum": [
        "shannon/pair",
        "shannon/device.resume",
        "shannon/query",
        "shannon/cancel",
        "shannon/approval/decide",
        "shannon/agent.list",
        "shannon/agent.detail",
        "shannon/model.list",
        "shannon/model.switch",
        "shannon/health",
        "shannon/task.dispatch",
        "shannon/task.list",
        "shannon/snapshot",
        "shannon/resume",
        "shannon/device.list",
        "shannon/device.revoke",
        "shannon/approval.list",
        "shannon/approval.state",
        "shannon/approval.set",
        "shannon/session.list",
        "shannon/session.history",
        "shannon/push.register",
        "shannon/trust.list",
        "shannon/trust.revoke",
        "shannon/usage.budget",
        "shannon/group.list",
        "shannon/group.create",
        "shannon/group.message",
        "shannon/group.archive"
      ]
    },
    "errorCodes": {
      "description": "Stable shannon band codes. Register new codes here AND in protocol.ts ShannonError AND mobile json_rpc.dart RpcError.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "PARSE_ERROR": -32700,
        "INVALID_REQUEST": -32600,
        "METHOD_NOT_FOUND": -32601,
        "NOT_IMPLEMENTED": -32603,
        "PAIRING_REQUIRED": -32000,
        "BAD_PARAMS": -32001,
        "ENGINE_ERROR": -32002,
        "CLOCK_SKEW": -32003,
        "GAP_TOO_LARGE": -32014
      },
      "required": [
        "PARSE_ERROR",
        "INVALID_REQUEST",
        "METHOD_NOT_FOUND",
        "NOT_IMPLEMENTED",
        "PAIRING_REQUIRED",
        "BAD_PARAMS",
        "ENGINE_ERROR",
        "CLOCK_SKEW",
        "GAP_TOO_LARGE"
      ]
    },
    "pairParams": {
      "type": "object",
      "required": [
        "pair_token",
        "device_public_key",
        "pop_signature"
      ],
      "properties": {
        "pair_token": {
          "type": "string"
        },
        "device_public_key": {
          "type": "string",
          "description": "JWK x — base64url of the 32-byte Ed25519 public key"
        },
        "pop_signature": {
          "type": "string",
          "description": "Ed25519 over \"${pair_token}:${device_public_key}\""
        },
        "device_label": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "deviceResumeParams": {
      "type": "object",
      "required": [
        "device_id",
        "timestamp",
        "signature"
      ],
      "properties": {
        "device_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "number",
          "description": "epoch ms, within ±60s skew"
        },
        "signature": {
          "type": "string",
          "description": "Ed25519 over \"${device_id}:${timestamp}\" or \"${device_id}:${timestamp}:${nonce}\""
        },
        "nonce": {
          "type": "string",
          "maxLength": 128,
          "description": "client-generated random; single-use per device within the skew window (anti-replay)"
        }
      }
    },
    "deviceSessionResult": {
      "type": "object",
      "required": [
        "device_id",
        "session_id"
      ],
      "properties": {
        "device_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "device_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastSeq": {
          "type": "number",
          "description": "push cursor (camelCase — historical)"
        }
      }
    },
    "queryParams": {
      "type": "object",
      "required": [
        "prompt"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "ignored unless equal to the bound device session (ownership)"
        }
      }
    },
    "approvalDecideParams": {
      "type": "object",
      "required": [
        "request_id",
        "choice",
        "signature"
      ],
      "properties": {
        "request_id": {
          "type": "string"
        },
        "choice": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "signature": {
          "type": "string",
          "description": "Ed25519 over the decision message — \"${request_id}:${choice}\" (v1) or \"${request_id}:${choice}:${timestamp}\" (v2) — with the scope suffix appended: \":session\" (P3-3) or \":kind:<kind>\" (N3). Mandatory when requireSession is on."
        },
        "timestamp": {
          "type": "integer",
          "description": "v2 anti-replay: epoch ms bound into the signed message; presence selects v2-only verification within ±approvalDecideTimestampWindowMs (300000). Absent = legacy v1 shape."
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "description": "How far an allow reaches: \"once\" (default, engine allow_once), \"session\" (P3-3, in-session, never persisted) or \"kind\" (N3, PERSISTED per-kind trust). Bound into the decision signature; deny rejects any scope.",
          "enum": [
            "once",
            "session",
            "kind"
          ]
        },
        "kind": {
          "description": "N3: with scope=\"kind\" — the category to trust (the engine tool name, exact match). Required (trimmed, 1..=128 chars); the engine degrades a mismatch with the pending ask's own kind to a one-shot allow.",
          "type": "string"
        }
      }
    },
    "shannonEvent": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "query.started",
            "task.progress",
            "query.completed",
            "query.failed",
            "query.cancelled",
            "approval.request",
            "task.message"
          ]
        },
        "turn_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string",
          "description": "§K3 routing key: on a dispatched task's stream (query.started / task.progress / task.message / query.failed) this IS the task's own id — the phone keys its local thread by it and routes by the session-key chain. Absent on plain query turns."
        },
        "content": {
          "type": "string"
        },
        "tool": {
          "type": "object"
        },
        "usage": {
          "type": "object"
        },
        "seq": {
          "type": "number",
          "description": "monotonic push cursor stamped by the gateway"
        },
        "model": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "tool_name": {
          "type": "string"
        },
        "tool_input": {},
        "description": {
          "type": "string"
        },
        "is_destructive": {
          "type": "boolean"
        },
        "diff_preview": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "ts": {
          "type": "number",
          "description": "§L1 (additive, approval.request): engine-side epoch-ms timestamp; absent on engines that don't supply it (phone falls back to arrival time)"
        },
        "agent": {
          "type": "object",
          "description": "§L1 (additive, approval.request): the requesting agent, when the engine supplies it",
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "risk": {
          "type": "object",
          "description": "§L1 (additive, approval.request): the engine's three-dimensional risk, when present",
          "properties": {
            "destructive": {
              "type": "boolean"
            },
            "scope": {
              "enum": [
                "local",
                "repo",
                "system"
              ]
            },
            "reversible": {
              "type": "boolean"
            }
          },
          "required": [
            "scope",
            "reversible"
          ]
        }
      }
    },
    "agentStateNotification": {
      "type": "object",
      "description": "P2-9 agent.state push (2026-10-08): a dedicated notification METHOD (not a shannon/event type) the phone's LiveAgentsNotifier consumes by params.agent. The agent map is the FULL shannon/agent.list roster shape — the phone REPLACES the matching roster entry with it (unknown ids are added), so role/model must ride when the definition declares them; currentTask is camelCase per the phone's agentFromMap, the only consumer. Ephemeral: seq-free, outside the shannon/resume replay ring (the Fleet screen re-converges via agent.list on its next bind).",
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "shannon/agent.state"
        },
        "params": {
          "type": "object",
          "required": [
            "agent"
          ],
          "properties": {
            "agent": {
              "type": "object",
              "required": [
                "id",
                "name",
                "status",
                "activity",
                "currentTask"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "the roster agent id (the ~/.shannon/agents/*.toml name)"
                },
                "name": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "description": "the definition's description — omitted when absent/empty (agent.list parity)"
                },
                "model": {
                  "type": "string",
                  "description": "the definition's model — omitted when absent/empty (agent.list parity)"
                },
                "status": {
                  "enum": [
                    "running",
                    "idle"
                  ]
                },
                "activity": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "shape parity with agent.list; always empty today"
                },
                "currentTask": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "the dispatched task text while running; explicitly null once idle"
                }
              }
            }
          }
        }
      }
    },
    "qrV2Payload": {
      "description": "Desktop QR (scan or file) — the out-of-band trust channel. Mobile mirror: methods.dart QrPairingPayload.",
      "type": "object",
      "required": [
        "v",
        "scheme",
        "host",
        "port",
        "token"
      ],
      "properties": {
        "v": {
          "enum": [
            1,
            2
          ]
        },
        "scheme": {
          "enum": [
            "ws",
            "wss"
          ]
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "number"
        },
        "token": {
          "type": "string",
          "description": "one-time pair token — the pairing AND (legacy) E2E trust root"
        },
        "exp": {
          "type": "number"
        },
        "displayName": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "direct",
            "relay"
          ]
        },
        "relayEndpoint": {
          "type": "string"
        },
        "relaySessionId": {
          "type": "string"
        },
        "hostE2EPubKey": {
          "type": "string",
          "description": "v0.3: base64url ephemeral X25519 pubkey of the host; presence selects the v2 ECDH key schedule"
        },
        "certFingerprint": {
          "type": "string",
          "description": "v0.12: lowercase hex SHA-256 of the gateway TLS cert; phones pin it when dialing wss"
        }
      }
    },
    "wireFixtures": {
      "description": "Frozen byte-level fixtures mirrored by mobile protocol_schema_contract_test.dart. Changing any of these requires a conscious cross-repo sync.",
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 5,
      "prefixItems": [],
      "enum-note": "see examples",
      "examples": [
        [
          "pair",
          {
            "pair_token": "tok",
            "device_public_key": "pub-b64url",
            "pop_signature": "sig-b64url",
            "device_label": "Shannon phone"
          }
        ],
        [
          "device.resume (nonce anti-replay)",
          {
            "device_id": "abc",
            "timestamp": 1700000000000,
            "signature": "sig-b64url",
            "nonce": "0f1e2d3c4b5a69788796a5b4c3d2e1f0"
          }
        ],
        [
          "approval.decide",
          {
            "request_id": "req-1",
            "choice": "deny",
            "signature": "sig-b64url"
          }
        ],
        [
          "approval.decide v2 (timestamp anti-replay)",
          {
            "request_id": "req-1",
            "choice": "deny",
            "signature": "sig-b64url",
            "timestamp": 1700000000000
          }
        ],
        [
          "task.progress notification",
          {
            "jsonrpc": "2.0",
            "method": "shannon/event",
            "params": {
              "seq": 42,
              "type": "task.progress",
              "content": "hello",
              "turn_id": "turn-1"
            }
          }
        ],
        [
          "clock-skew rejection",
          {
            "jsonrpc": "2.0",
            "id": 9,
            "error": {
              "code": -32003,
              "message": "timestamp outside skew window"
            }
          }
        ],
        [
          "trust.list",
          {
            "kinds": [
              {
                "kind": "Bash",
                "grantedAt": "2026-10-08T03:24:00.000Z"
              }
            ]
          }
        ]
      ]
    },
    "trustListParams": {
      "type": "object",
      "description": "shannon/trust.list takes no parameters (reserve-then-enable: future paging/history fields land additively)."
    },
    "trustListResult": {
      "type": "object",
      "required": [
        "kinds"
      ],
      "properties": {
        "kinds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "grantedAt"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "description": "The trusted kind — the engine tool name, matched EXACTLY on later approval requests (no globs, no prefix semantics; never a global always-allow)."
              },
              "grantedAt": {
                "type": "string",
                "description": "ISO-8601 UTC instant the grant was made."
              }
            }
          }
        }
      },
      "description": "shannon/trust.list success — active per-kind trust grants, sorted by kind. Old gateways answer METHOD_NOT_FOUND: that absence IS the capability signal (capability name `trust.kind`, the usage.budget degrade precedent) and the phone's trust switch hides/disables."
    },
    "trustRevokeParams": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "The kind to revoke. Idempotent: an unknown kind still answers ok (a retried revoke from the phone's offline queue cannot fail)."
        }
      },
      "description": "shannon/trust.revoke request — removal takes effect immediately (the engine's permission gate consults the store live on every check)."
    },
    "trustRevokeResult": {
      "type": "object",
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "const": true
        }
      },
      "description": "shannon/trust.revoke success."
    }
  },
  "type": "object",
  "properties": {
    "shannonMethods": {
      "$ref": "#/definitions/shannonMethods"
    },
    "errorCodes": {
      "$ref": "#/definitions/errorCodes"
    },
    "qrV2Payload": {
      "$ref": "#/definitions/qrV2Payload"
    },
    "wireFixtures": {
      "$ref": "#/definitions/wireFixtures"
    }
  },
  "required": [
    "shannonMethods",
    "errorCodes",
    "qrV2Payload",
    "wireFixtures"
  ]
}
