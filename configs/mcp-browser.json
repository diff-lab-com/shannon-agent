// MCP Browser Configuration Template
// Copy to your project as .mcp.json to enable browser automation
// Requires: npx @playwright/mcp (official Playwright MCP server)
// Or run `/browser setup` in the Shannon REPL to merge it automatically.
{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    }
  }
}
